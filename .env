# Base URL of the backend REST API.
# Vite inlines this at BUILD time — for Docker images pass it as a build arg.
#
# Local backend (npm run dev in /backend):      http://localhost:4000/api
# Backend in Docker, published on the host:     http://localhost:4000/api
# Docker Compose (browser talks to the host):   http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api
